{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aitp/prediction_ledger.schema.json",
  "title": "AITP Prediction Record v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prediction_id",
    "schema_version",
    "exact_wording",
    "date_time_claimed",
    "source",
    "success_condition",
    "failure_condition",
    "content_sha256",
    "frozen_sha256",
    "status"
  ],
  "properties": {
    "prediction_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "AITP-PRED-1.1"
    },
    "exact_wording": {
      "type": "string",
      "minLength": 1
    },
    "date_time_claimed": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "target_event": {
      "type": "string"
    },
    "time_window": {
      "type": "string"
    },
    "probability_language": {
      "type": "string"
    },
    "conditional_language": {
      "type": "string"
    },
    "success_condition": {
      "type": "string",
      "minLength": 1
    },
    "failure_condition": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frozen_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "FROZEN",
        "ADJUDICATED"
      ]
    }
  }
}
